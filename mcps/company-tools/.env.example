# --- Upstream company services -------------------------------------------------------
INCIDENT_API_BASE_URL=http://localhost:8000
INVENTORY_API_BASE_URL=http://localhost:8000
MCP_UPSTREAM_TIMEOUT_SECONDS=4.0
# Service account the MCP server uses to read the (JWT-protected) inventory API
AGENT_SERVICE_EMAIL=
AGENT_SERVICE_PASSWORD=

# --- OAuth (MCP Auth, resource-server mode) -------------------------------------------
# Issuer of your OIDC provider (Auth0: https://YOUR_TENANT.us.auth0.com/ -- keep the trailing slash
# exactly as the provider publishes it in its discovery document).
OIDC_ISSUER=
# Public URL of THIS server's MCP endpoint (the Codespaces forwarded URL + /mcp when demoing).
MCP_RESOURCE_URL=http://localhost:8001/mcp
# Token audience. Defaults to MCP_RESOURCE_URL; set it if the provider API identifier differs.
MCP_AUDIENCE=
# Per-tool least-privilege scopes (incidents:read, incidents:write, inventory:read).
MCP_ENFORCE_SCOPES=true

MCP_HOST=0.0.0.0
MCP_PORT=8001

# --- Agent side (services/api) ---------------------------------------------------------
# MCP_SERVER_URL=http://localhost:8001/mcp
# MCP_ACCESS_TOKEN=               # static token for local dev, OR the client-credentials trio:
# MCP_TOKEN_URL=
# MCP_CLIENT_ID=
# MCP_CLIENT_SECRET=
# MCP_AUDIENCE=
# MCP_SCOPE=incidents:read inventory:read
